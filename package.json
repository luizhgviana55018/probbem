{
  "name": "probem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site e API da ONG ProBem",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:api\" \"npm:web\"",
    "api": "node --watch --env-file=.env server/index.js",
    "web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file=.env server/index.js",
    "test": "node --test server/"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  },
  "engines": { "node": ">=20.6" }
}
